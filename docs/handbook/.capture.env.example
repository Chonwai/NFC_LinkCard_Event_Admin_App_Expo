# Copy to .capture.env and fill in. .capture.env is gitignored.
#
# These are LOCAL DEMO credentials only. The account is created by the
# App handbook seeder (see tools/seed-app-demo.md) and exists only in the
# local development database. Never put production credentials here.

# Where the app under documentation is served (Expo web).
HANDBOOK_URL=http://localhost:8090

# Organiser account — owns the handbook demo events.
HANDBOOK_LOGIN_EMAIL=
HANDBOOK_LOGIN_PASSWORD=

# Door-staff account — used for the limited-permission journey, if the
# demo dataset provisions one.
HANDBOOK_STAFF_EMAIL=
HANDBOOK_STAFF_PASSWORD=

# Slug + id of the primary handbook demo event.
# Leave these BLANK. The seeder rebuilds its event on every run, so it writes
# the current ids and registration codes to .capture/seed.json, and the tooling
# reads them from there. A hand-copied id goes stale silently: the event screens
# simply report that they could not load.
HANDBOOK_EVENT_SLUG=
HANDBOOK_EVENT_ID=
